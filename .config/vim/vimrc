" ~/.config/vim/vimrc
set nocompatible
set hidden
set laststatus=0
set showtabline=0
set ttimeoutlen=0
set mouse=a
set noshowmode
set incsearch
set hlsearch
set encoding=utf-8
set clipboard=unnamed
set backspace=indent,eol,start
set list
set listchars=trail:·,tab:»·,extends:›,precedes:‹,nbsp:␣
set packpath^=~/.local/share/vim
set viminfofile=~/.cache/vim/info
set completeopt+=popup
let g:airline_powerline_fonts=1
let g:airline#extensions#tabline#enabled=1
let g:loaded_netrwPlugin=1
filetype plugin on
colorscheme codedark
syntax on

function! QuickfixFilter()
  let l:qf_list = getqflist()
  if empty(l:qf_list)
    echo "Quickfix list is empty!"
    return
  endif

  let l:lines = []
  let l:idx = 0
  for item in l:qf_list
    if item.valid
      let l:bufname = bufname(item.bufnr)
      call add(l:lines, l:idx . ' ' . l:bufname . ':' . item.lnum . ':' . item.text)
    endif
    let l:idx += 1
  endfor

  let l:selection = system('fzf --ansi -m', join(l:lines, "\n"))

  if v:shell_error == 0 && !empty(l:selection)
    let l:filtered_qf = []
    let l:chosen_lines = split(l:selection, "\n")

    for l:line in l:chosen_lines
      let l:idx_str = matchstr(l:line, '^\d\+')
      if !empty(l:idx_str)
        let l:orig_idx = str2nr(l:idx_str)
        call add(l:filtered_qf, l:qf_list[l:orig_idx])
      endif
    endfor

    " let l:saved_view = winsaveview()
    call setqflist(l:filtered_qf, 'r')
    " call winrestview(l:saved_view)
  endif

  redraw!
endfunction


if executable('fzf')
  command! Cfilter call QuickfixFilter()
  augroup Fzf
    autocmd!
    autocmd FileType qf nnoremap <buffer> f :Cfilter<CR>
    autocmd FileType qf nnoremap <buffer> q :cclose<CR>
  augroup END
endif

function! Search(query)
  let l:cmd = "rg --vimgrep --smart-case " . shellescape(a:query)
  cgetexpr system(l:cmd)
  if !empty(getqflist())
    copen
  else
    redraw | echo "No matches found"
  endif
endfunction

if executable('rg')
  nnoremap <leader>g :call Search(input('Search: '))<CR>
  vnoremap <leader>g "jy:call Search(@j)<CR>
  nnoremap <C-j> :cnext<CR>
  nnoremap <C-k> :cprev<CR>
endif


