<!-- /etc/clickhouse-server/config.d/server.xml -->
<clickhouse>
    <http_port remove="1"/>
    <mysql_port remove="1"/>
    <postgresql_port remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <query_log remove="1"/>
    <query_thread_log remove="1"/>
    <part_log remove="1"/>
    <trace_log remove="1"/>
    <text_log remove="1"/>
    <crash_log remove="1"/>
    <session_log remove="1"/>
    <error_log remove="1"/>
    <processors_profile_log remove="1"/>
    <background_schedule_pool_log remove="1"/>
    <odbc_bridge><disable>true</disable></odbc_bridge>
    <jdbc_bridge><disable>true</disable></jdbc_bridge>
    <library_bridge><disable>true</disable></library_bridge>
</clickhouse>
