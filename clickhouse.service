[Unit]
Description=ClickHouse Server
Documentation=https://clickhouse.com/docs
Requires=network-online.target
After=time-sync.target network-online.target
Wants=time-sync.target

[Service]
Type=simple
User=clickhouse
Group=clickhouse
ExecStart=/usr/bin/clickhouse-server --config-file=/etc/clickhouse-server/config.xml --pid-file=/run/clickhouse-server/clickhouse-server.pid
ExecStop=/usr/bin/clickhouse stop
Restart=on-failure
LimitNOFILE=500000
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal
Environment=CLICKHOUSE_LOG_STDOUT=1

[Install]
WantedBy=multi-user.target

