[Unit]
Description=Prometheus Nginx Exporter
Documentation=https://github.com/nginx/nginx-prometheus-exporter
After=network.target

[Service]
User=root
Group=root
ExecStart=/usr/local/bin/nginx_exporter --web.listen-address=127.0.0.1:9113 --nginx.scrape-uri=http://127.0.0.1/metrics
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

