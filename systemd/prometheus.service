[Unit]
Description=Prometheus Server
Documentation=https://github.com/prometheus/prometheus
After=network.target

[Service]
User=root
Group=root
ExecStart=/usr/local/bin/prometheus --web.listen-address=127.0.0.1:9090 --web.external-url="https://prometheus..." --log.level=info --config.file=/root/system/prometheus.yml --storage.tsdb.path=/root/system/data
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

