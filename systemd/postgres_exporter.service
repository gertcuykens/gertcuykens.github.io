[Unit]
Description=Prometheus Postgres Exporter
Documentation=https://github.com/prometheus-community/postgres_exporter
After=network.target

[Service]
User=root
Group=root
Environment="DATA_SOURCE_NAME=host=/run/postgresql port=5432 sslmode=disable user=postgres"
ExecStart=/usr/local/bin/postgres_exporter --web.listen-address=127.0.0.1:9187
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

