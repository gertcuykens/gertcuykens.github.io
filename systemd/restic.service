[Unit]
Description=Restic
Documentation=https://restic.readthedocs.io
After=network.target

[Service]
User=gert
Group=gert
Type=oneshot
WorkingDirectory=/home/gert
LoadCredential=env:/root/.zshenv
ExecStart=/bin/zsh -c 'set -a; source "${CREDENTIALS_DIRECTORY}/env"; set +a; exec /home/gert/restic.sh'
StandardOutput=journal
StandardError=journal

